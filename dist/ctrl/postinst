#!/bin/sh
APP_DIR=/media/developer/apps/usr/palm/applications/com.neoscaler.bpr1s-keymapper
HOOK=/var/lib/webosbrew/init.d/60-bpr1s-keymapper
chmod 755 "$APP_DIR/bin/bpr1s-keymapper" 2>/dev/null
chmod 755 "$HOOK" 2>/dev/null
if [ -f /tmp/webosbrew_startup ] && [ -x "$HOOK" ]; then
    "$HOOK" &
fi
exit 0
