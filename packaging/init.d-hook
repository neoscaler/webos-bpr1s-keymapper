#!/bin/sh
ID=com.neoscaler.bpr1s-keymapper
BIN_NAME=bpr1s-keymapper
PIDFILE=/tmp/bpr1s-keymapper.loop.pid
LOG=/tmp/bpr1s-keymapper.log
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    [ "$1" = restart ] || exit 0
    kill "$(cat "$PIDFILE")" 2>/dev/null
    n=0
    while kill -0 "$(cat "$PIDFILE")" 2>/dev/null && [ "$n" -lt 5 ]; do
        sleep 1
        n=$((n + 1))
    done
    rm -f "$PIDFILE"
fi
APP_DIR=
for root in /media/developer/apps /media/cryptofs/apps; do
    if [ -x "$root/usr/palm/applications/$ID/bin/$BIN_NAME" ]; then
        APP_DIR="$root/usr/palm/applications/$ID"
        break
    fi
done
[ -n "$APP_DIR" ] || exit 0
BIN="$APP_DIR/bin/$BIN_NAME"
(
    child=
    trap '[ -n "$child" ] && kill "$child" 2>/dev/null; exit 0' TERM INT
    fails=0
    while [ -x "$BIN" ] && [ "$fails" -lt 5 ]; do
        nice -n 19 "$BIN" </dev/null >>"$LOG" 2>&1 &
        child=$!
        wait "$child"
        child=
        fails=$((fails + 1))
        [ -x "$BIN" ] || break
        sleep 2
    done
) &
echo $! >"$PIDFILE"
