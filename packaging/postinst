#!/bin/sh
ID=com.neoscaler.bpr1s-keymapper
HOOK=/var/lib/webosbrew/init.d/60-bpr1s-keymapper
APP_DIR=
for root in /media/developer/apps /media/cryptofs/apps; do
    if [ -d "$root/usr/palm/applications/$ID" ]; then
        APP_DIR="$root/usr/palm/applications/$ID"
        break
    fi
done
[ -n "$APP_DIR" ] || exit 0
chmod 755 "$APP_DIR/bin/bpr1s-keymapper" 2>/dev/null
mkdir -p /var/lib/webosbrew/init.d 2>/dev/null
cp "$APP_DIR/bin/60-bpr1s-keymapper" "$HOOK" 2>/dev/null || exit 0
chmod 755 "$HOOK" 2>/dev/null
[ -f /tmp/webosbrew_startup ] && "$HOOK"
exit 0
